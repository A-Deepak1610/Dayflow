generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(uuid())
  name      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())
  users     User[]
  
  @@map("companies")
}

model Role {
  id    String @id @default(uuid())
  name  String @unique // ADMIN, HR, EMPLOYEE
  users User[]

  @@map("roles")
}

model User {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  
  firstName     String
  lastName      String
  phone         String?
  
  // Auth Fields
  loginId       String   @unique // Auto-generated e.g. OIJODO20220001
  email         String   @unique
  password      String   // Hashed via bcrypt
  isFirstLogin  Boolean  @default(true) // Forces password change on first login
  
  roleId        String
  role          Role     @relation(fields: [roleId], references: [id])
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  refreshTokens RefreshToken[]
  attendances   Attendance[]
  salaries      Salary[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique @db.VarChar(512)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)

  @@map("refresh_tokens")
}

model Attendance {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date
  clockIn     DateTime
  clockOut    DateTime?
  status      String    // "On Time", "Late", "Absent", "Half-day"
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, date])
  @@map("attendances")
}

model Salary {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month       Int
  year        Int
  baseSalary  Float
  allowances  Float    @default(0)
  deductions  Float    @default(0)
  netSalary   Float
  status      String   // "Pending", "Paid"
  createdAt   DateTime @default(now())

  @@unique([userId, month, year])
  @@map("salaries")
}
